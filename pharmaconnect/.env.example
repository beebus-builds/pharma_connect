# Neon PostgreSQL (https://console.neon.tech -> Connection Details)
# Use the "pooled" connection string for DATABASE_URL and the direct one for DIRECT_URL
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Realtime chat service (Render URL in production)
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# Email (SMTP — Gmail by default; verification, welcome, password-reset + notifications)
# Create a Gmail App password (Google Account -> 2-Step Verification -> App passwords)
# and put it here. Restart the dev server after changing this file.
# Without SMTP_USER/SMTP_PASS the app runs but emails are skipped (see logs).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="you@gmail.com"
SMTP_FROM_NAME="PharmaConnect"
# Optional: new-listing reports also email this admin inbox
ADMIN_NOTIFY_EMAIL=""
# Pharmacy photos (Vercel Blob — required in production since Vercel's
# filesystem is read-only; without it uploads fall back to local disk which
# only works in dev / on a VPS with persistent storage)
# Vercel Dashboard -> Storage -> Create Blob store -> .env -> BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# Google Maps pinpoint picker (optional — app works without it)
# Get your own key: https://console.cloud.google.com -> create project ->
# enable "Maps JavaScript API" + "Places API" -> Credentials -> Create API key ->
# restrict it to your domain. Billing must be enabled on the project.
# Without this key the register form uses a Google Maps embed + manual pin flow.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
