generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  PHARMACY
  ADMIN
}

enum RequestStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReportReason {
  WRONG_STOCK
  CLOSED
  WRONG_LOCATION
  FAKE_LISTING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PharmacyImageKind {
  PROFILE
  COVER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  emailVerified Boolean @default(false)
  verificationToken String?
  verificationTokenExpires DateTime?
  passwordResetToken String? @unique
  passwordResetExpires DateTime?
  createdAt DateTime @default(now())

  pharmacy Pharmacy?
  requests Request[] @relation("PatientRequests")
  messages Message[]
  reports  Report[]  @relation("ReporterReports")

  @@index([email])
}

model Pharmacy {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  address       String
  phone         String
  latitude      Float
  longitude     Float
  location      Unsupported("geography(Point, 4326)")?
  licenseNumber String?

  stocks   PharmacyStock[]
  requests Request[]       @relation("PharmacyRequests")
  payments Payment[]
  reports  Report[]        @relation("PharmacyReports")
  images   PharmacyImage[]
  stockHistory StockHistory[]

  subscriptionActive    Boolean   @default(false)
  subscriptionExpiresAt DateTime?

  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@index([location], type: Gist, map: "Pharmacy_location_gist_idx")
  @@index([name])
}

model Payment {
  id         String        @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purpose    String        @default("SUBSCRIPTION")
  amount     Int
  status     PaymentStatus @default(PENDING)
  pidx       String?       @unique
  transactionId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([pharmacyId])
  @@index([status])
}

model Medicine {
  id           String @id @default(cuid())
  genericName  String
  brandName    String
  strength     String
  manufacturer String

  stocks   PharmacyStock[]
  stockHistory StockHistory[]
  requests Request[]

  @@index([genericName])
  @@index([brandName])
}

model PharmacyStock {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)
  // Production inventory fields
  expiryDate          DateTime?
  mrp                 Int?
  lowStockThreshold   Int       @default(10)
  lowStockAlertSentAt DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([pharmacyId, medicineId])
  @@index([medicineId])
  @@index([pharmacyId])
  @@index([expiryDate])
}

model StockHistory {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  oldQuantity Int
  newQuantity Int
  delta       Int
  note        String?  @db.VarChar(200)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@index([medicineId])
}

model Request {
  id         String        @id @default(cuid())
  patientId  String
  patient    User          @relation("PatientRequests", fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyId String
  pharmacy   Pharmacy      @relation("PharmacyRequests", fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  conversation Conversation?

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
}

model Conversation {
  id         String   @id @default(cuid())
  requestId  String   @unique
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  patientId  String
  pharmacyId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  messages   Message[]

  @@index([patientId])
  @@index([pharmacyId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PharmacyImage {
  id         String            @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  kind       PharmacyImageKind
  url        String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([pharmacyId, kind])
  @@index([pharmacyId])
}

model Report {
  id         String       @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy     @relation("PharmacyReports", fields: [pharmacyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([pharmacyId])
  @@index([status])
  @@index([reporterId])
}
